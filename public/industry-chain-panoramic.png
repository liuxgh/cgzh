<line x1="0" y1="970" x2="1920" y2="1210" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="1005" x2="1920" y2="1245" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="1040" x2="1920" y2="1280" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="1075" x2="1920" y2="1315" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="1110" x2="1920" y2="1350" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="1145" x2="1920" y2="1385" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="1180" x2="1920" y2="1420" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="1215" x2="1920" y2="1455" stroke="#0b244d" stroke-dasharray="4,6"/>
    <line x1="1920" y1="200" x2="0" y2="440" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="235" x2="0" y2="475" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="270" x2="0" y2="510" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="305" x2="0" y2="545" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="340" x2="0" y2="580" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="375" x2="0" y2="615" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="410" x2="0" y2="650" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="445" x2="0" y2="685" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="480" x2="0" y2="720" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="515" x2="0" y2="755" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="550" x2="0" y2="790" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="585" x2="0" y2="825" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="620" x2="0" y2="860" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="655" x2="0" y2="895" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="690" x2="0" y2="930" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="725" x2="0" y2="965" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="760" x2="0" y2="1000" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="795" x2="0" y2="1035" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="830" x2="0" y2="1070" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="865" x2="0" y2="1105" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="900" x2="0" y2="1140" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="1920" y1="935" x2="0" y2="1175" stroke="#0b244d" stroke-dasharray="4,6"/>
