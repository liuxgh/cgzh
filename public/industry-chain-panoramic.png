<line x1="0" y1="550" x2="1920" y2="790" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="585" x2="1920" y2="825" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="620" x2="1920" y2="860" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="655" x2="1920" y2="895" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="690" x2="1920" y2="930" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="725" x2="1920" y2="965" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="760" x2="1920" y2="1000" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="795" x2="1920" y2="1035" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="830" x2="1920" y2="1070" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="865" x2="1920" y2="1105" stroke="#0b244d" stroke-dasharray="4,6"/>
<line x1="0" y1="900" x2="1920" y2="1140" stroke="#0b244d" stroke-dasharray="4,6"/>
